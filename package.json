{
  "name": "unmai",
  "version": "1.0.0",
  "description": "unmai.ai - AI-powered content verification and analysis platform",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "./scripts/build-production.sh",
    "build:fast": "SKIP_TESTS=true ./scripts/build-production.sh",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:frontend": "cd frontend && npm run start",
    "start:backend": "cd backend && npm run start",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "clean": "npm run clean:frontend && npm run clean:backend && rm -f build-manifest.json",
    "clean:frontend": "cd frontend && rm -rf .next node_modules .env.local .env.production",
    "clean:backend": "cd backend && rm -rf dist node_modules",
    "clean:all": "npm run clean && rm -rf node_modules .env.jwt .env.secret",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:backend",
    "typecheck:frontend": "cd frontend && npm run typecheck",
    "typecheck:backend": "cd backend && npm run typecheck",
    "setup:jwt": "node scripts/setup-jwt-env.js",
    "setup:gcp": "./scripts/setup-gcp-secrets.sh",
    "test:connectivity": "node scripts/test-connectivity.js",
    "deploy:local": "docker-compose up --build",
    "deploy:production": "gcloud builds submit --config cloudbuild-minimal.yaml --substitutions _REGION=us-central1",
    "deploy:cloud": "npm run deploy:production",
    "deploy:complete": "./scripts/deploy-complete.sh",
    "validate": "./scripts/validate-deployment.sh",
    "logs:backend": "gcloud logging read 'resource.type=cloud_run_revision AND resource.labels.service_name=unmai-backend' --limit=50 --format=json",
    "logs:frontend": "gcloud logging read 'resource.type=cloud_run_revision AND resource.labels.service_name=unmai-frontend' --limit=50 --format=json",
    "status": "gcloud run services list --filter='metadata.name:unmai-' --format='table(metadata.name,status.url,status.conditions[0].type)'",
    "health": "npm run test:connectivity"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "overrides": {
    "protobufjs": "^7.4.0",
    "@tootallnate/once": "^3.0.1",
    "http-proxy-agent": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
