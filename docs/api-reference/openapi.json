{
  "openapi": "3.0.0",
  "info": {
    "title": "Unmai.ai API",
    "version": "1.0.0",
    "description": "API for Unmai.ai - The AI-Powered Content Verification Platform"
  },
  "servers": [
    {
      "url": "https://unmai-backend-helpful-cat-465008-h1.a.run.app",
      "description": "Production Server"
    },
    {
      "url": "http://localhost:3001",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AnalysisRequest": {
        "type": "object",
        "required": ["type", "payload"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["text", "url", "image", "video", "audio"]
          },
          "payload": {
            "type": "object",
            "description": "The content to analyze. Structure depends on 'type'."
          },
          "searchEngineId": {
            "type": "string",
            "description": "Optional Google Custom Search Engine ID"
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "description": "Simple health check endpoint to verify the service is running.",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "timestamp": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/analyze": {
      "post": {
        "summary": "Unified Analysis",
        "description": "Perform comprehensive analysis on various content types (text, image, video, etc.).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalysisRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Analysis results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "500": {
            "description": "Server Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/fact-check": {
      "post": {
        "summary": "Fact Check Claim",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["claim"],
                "properties": {
                  "claim": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Fact check result" }
        }
      }
    },
    "/api/detect-deepfake": {
      "post": {
        "summary": "Detect Deepfake",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["media", "contentType"],
                "properties": {
                  "media": { "type": "string", "description": "Base64 encoded media or URL" },
                  "contentType": { "type": "string", "enum": ["image", "video"] },
                  "sourceCredibility": { "type": "number" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Deepfake detection result" }
        }
      }
    },
    "/api/safety-assessment": {
      "post": {
        "summary": "Safety Assessment",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["content", "contentType"],
                "properties": {
                  "content": { "type": "string" },
                  "contentType": { "type": "string", "enum": ["text", "url", "image"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Safety assessment result" }
        }
      }
    }
  }
}
